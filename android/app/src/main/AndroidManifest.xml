<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />

        </activity>

        <!-- Icono de la app a elegir (Ajustes → Icono de la app): cada uno es un «alias» que abre la misma app;
             solo uno está activo a la vez. -->
        <activity-alias
            android:name=".IconoClasico"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoNoche"
            android:targetActivity=".MainActivity"
            android:icon="@drawable/ic_alt_noche"
            android:roundIcon="@drawable/ic_alt_noche"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoAzulejo"
            android:targetActivity=".MainActivity"
            android:icon="@drawable/ic_alt_azulejo"
            android:roundIcon="@drawable/ic_alt_azulejo"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoFeria"
            android:targetActivity=".MainActivity"
            android:icon="@drawable/ic_alt_feria"
            android:roundIcon="@drawable/ic_alt_feria"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoSemanaSanta"
            android:targetActivity=".MainActivity"
            android:icon="@drawable/ic_alt_semanasanta"
            android:roundIcon="@drawable/ic_alt_semanasanta"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoGiralda"
            android:targetActivity=".MainActivity"
            android:icon="@drawable/ic_alt_giralda"
            android:roundIcon="@drawable/ic_alt_giralda"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconoVerde"
            android:targetActivity=".MainActivity"
            android:icon="@drawable/ic_alt_verde"
            android:roundIcon="@drawable/ic_alt_verde"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Widget de pantalla de inicio: una parada favorita con sus próximos autobuses -->
        <receiver
            android:name=".BusSevWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="es.bussev.app.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bussev_widget_info" />
        </receiver>

        <!-- Aviso de llegada que se corrige solo con la app cerrada (vuelve a preguntar a TUSSAM) -->
        <receiver
            android:name=".LlegadaReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="es.bussev.app.LLEGADA_REVISAR" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- «Avísame cuando tenga que bajarme»: sigue el GPS mientras vas en el autobús (con notificación fija) -->
        <service
            android:name=".BajadaService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Modo sensor: vibra según se acerca tu autobús (con notificación fija y chip en la barra) -->
        <service
            android:name=".SensorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".BusSevWidgetConfig"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Avisos de llegada: notificaciones + alarma exacta (que salte a su hora, no «cuando el sistema quiera»)
         y volver a programarlas tras reiniciar el móvil. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Avísame al bajar: servicio en primer plano que usa la ubicación mientras vas en el autobús -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Modo sensor: servicio que pregunta a TUSSAM con la pantalla apagada -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 16: la cuenta atrás del bus como chip en la barra de estado («Live Updates») -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Actualizar BusSev desde dentro de la app: permite abrir el instalador de Android con la versión nueva
         descargada de GitHub (Android te pide igualmente que lo autorices la primera vez). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
